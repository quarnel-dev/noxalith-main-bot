{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "types": [
            "node"
        ],
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "noEmitOnError": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": [
        "src/**/*.ts"
    ]
}